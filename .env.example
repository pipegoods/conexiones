# Copia este archivo a .env.local y llena los valores.
# .env.local está en .gitignore: nunca subas credenciales al repo.

# --- Base de datos (Neon) ---
# Créala en https://console.neon.tech -> New Project -> copia la "Connection string"
# Debe terminar en ?sslmode=require
DATABASE_URL="postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/conexiones?sslmode=require"

# --- Sesión del panel interno ---
# Genera uno con: openssl rand -base64 32
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# --- WhatsApp ---
# Número del equipo de Conexiones en formato internacional sin + ni espacios.
# Se usa para armar los enlaces wa.me que abre el operador desde el panel.
NEXT_PUBLIC_WHATSAPP_EQUIPO="573001234567"

# URL pública del sitio (para enlaces absolutos en los mensajes de WhatsApp)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
